# Keep pinned upstream sources untouched. Fail closed if expected patch sites change.
set(CHLOE_OVERLAY "${CMAKE_CURRENT_BINARY_DIR}/chloe-overlay")
macro(chloe_replace needle replacement expected)
    string(LENGTH "${text}" before)
    string(REPLACE "${needle}" "" removed "${text}")
    string(LENGTH "${removed}" after)
    string(LENGTH "${needle}" size)
    math(EXPR count "(${before}-${after})/${size}")
    if(NOT count EQUAL ${expected})
        message(FATAL_ERROR "CHLOE pinned source patch mismatch: ${relative} (${count}, expected ${expected})")
    endif()
    string(REPLACE "${needle}" "${replacement}" text "${text}")
endmacro()
foreach(relative gguf_loader.cpp decoder/decoder_loader.cpp transformer/transformer_loader.cpp transformer/transformer_runtime.cpp transformer/transformer_runtime_code_pred.cpp decoder/decoder_runtime.cpp)
    file(READ "${QWEN3_TTS_ROOT}/src/${relative}" text)
    if(relative STREQUAL "gguf_loader.cpp")
        chloe_replace("    if (backend) {\n        shared.backend = backend;" "    if (backend) {\n        if (chloe::gpu_required() && ggml_backend_dev_type(ggml_backend_get_device(backend)) == GGML_BACKEND_DEVICE_TYPE_CPU) {\n            ggml_backend_free(backend);\n            if (error_msg) *error_msg = \"GPU requested but runtime selected CPU; choose CPU mode\";\n            return nullptr;\n        }\n        shared.backend = backend;" 1)
        chloe_replace("    // Allocate buffer for all tensors" "    if (chloe::gpu_required() && preferred_backend_type != GGML_BACKEND_DEVICE_TYPE_CPU && ggml_backend_dev_type(ggml_backend_get_device(backend)) == GGML_BACKEND_DEVICE_TYPE_CPU) {\n        ggml_backend_free(backend); error_msg = \"GPU weight allocation fell back to CPU\"; return false;\n    }\n    // Allocate buffer for all tensors" 1)
    elseif(relative STREQUAL "decoder/decoder_loader.cpp")
        chloe_replace("get_preferred_backend_type()))" "(chloe::cpu_decoder() ? GGML_BACKEND_DEVICE_TYPE_CPU : get_preferred_backend_type())))" 1)
        chloe_replace("state.backend_shared = shared_backend;\n    state.backend = shared_backend" "state.backend_shared = shared_backend && !chloe::cpu_decoder();\n    state.backend = chloe::cpu_decoder() ? init_cpu_backend(\"CHLOE CPU decoder\", &error_msg) : shared_backend" 1)
        chloe_replace("    ggml_backend_dev_t device = ggml_backend_get_device(state.backend);" "    chloe::note_backend(\"decoder\", state.backend);\n    ggml_backend_dev_t device = ggml_backend_get_device(state.backend);" 1)
    elseif(relative STREQUAL "transformer/transformer_loader.cpp")
        chloe_replace("    ggml_backend_dev_t device = ggml_backend_get_device(impl_->state.backend);" "    chloe::note_backend(\"transformer\", impl_->state.backend);\n    ggml_backend_dev_t device = ggml_backend_get_device(impl_->state.backend);" 1)
    elseif(relative STREQUAL "transformer/transformer_runtime.cpp")
        chloe_replace("if (ggml_backend_sched_graph_compute(impl_->state.sched, gf)" "chloe::prepare_graph(impl_->state.sched, gf, \"talker\");\n    if (ggml_backend_sched_graph_compute(impl_->state.sched, gf)" 2)
    elseif(relative STREQUAL "transformer/transformer_runtime_code_pred.cpp")
        chloe_replace("if (ggml_backend_sched_graph_compute(impl_->state.sched, gf)" "chloe::prepare_graph(impl_->state.sched, gf, \"code_predictor\");\n    if (ggml_backend_sched_graph_compute(impl_->state.sched, gf)" 3)
    elseif(relative STREQUAL "decoder/decoder_runtime.cpp")
        chloe_replace("if (ggml_backend_sched_graph_compute(state.sched, gf)" "chloe::prepare_graph(state.sched, gf, \"decoder\");\n    if (ggml_backend_sched_graph_compute(state.sched, gf)" 1)
    endif()
    get_filename_component(directory "${CHLOE_OVERLAY}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(WRITE "${CHLOE_OVERLAY}/${relative}" "#include \"chloe_backend_policy.h\"\n${text}")
endforeach()
