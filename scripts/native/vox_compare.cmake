# Inject only a comparison executable; do not edit the pinned upstream checkout.
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR AND NOT TARGET chloe-vox-compare)
    add_executable(chloe-vox-compare "${CMAKE_CURRENT_LIST_DIR}/vox_compare.cpp")
    set_property(TARGET chloe-vox-compare PROPERTY CXX_STANDARD 17)
    target_include_directories(chloe-vox-compare PRIVATE "${CMAKE_SOURCE_DIR}/tools/omni/voxcpm2" "${CMAKE_SOURCE_DIR}/include" "${CMAKE_SOURCE_DIR}/ggml/include")
    target_link_libraries(chloe-vox-compare PRIVATE voxcpm2_runtime)
endif()

# The pinned mobile fork calls Apple's F_NOCACHE on all POSIX hosts.
# Guard only those cache hints in a build-directory copy. VoxCPM2 is dense, not MoE.
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
    function(chloe_vox_linux_overlay)
        set(original "${CMAKE_SOURCE_DIR}/src/llama-moe-slot.cpp")
        file(READ "${original}" content)
        foreach(needle "fcntl(kv.second, F_NOCACHE, on ? 1 : 0)" "fcntl(fd, F_NOCACHE, 1)")
            string(FIND "${content}" "${needle}" found)
            if(found LESS 0)
                message(FATAL_ERROR "Pinned Vox runtime cache-hint patch site changed")
            endif()
        endforeach()
        string(REPLACE "fcntl(kv.second, F_NOCACHE, on ? 1 : 0)" "chloe_set_nocache(kv.second, on)" content "${content}")
        string(REPLACE "fcntl(fd, F_NOCACHE, 1)" "chloe_set_nocache(fd, true)" content "${content}")
        set(prefix "#include <fcntl.h>\nstatic int chloe_set_nocache(int fd, bool on) {\n#ifdef F_NOCACHE\nreturn fcntl(fd, F_NOCACHE, on ? 1 : 0);\n#else\n(void)fd; (void)on; return 0;\n#endif\n}\n")
        set(patched "${CMAKE_BINARY_DIR}/chloe-llama-moe-slot.cpp")
        file(WRITE "${patched}" "${prefix}${content}")
        get_target_property(sources llama SOURCES)
        list(REMOVE_ITEM sources "llama-moe-slot.cpp")
        list(APPEND sources "${patched}")
        set_property(TARGET llama PROPERTY SOURCES "${sources}")
        target_include_directories(llama PRIVATE "${CMAKE_SOURCE_DIR}/src")
    endfunction()
    cmake_language(DEFER CALL chloe_vox_linux_overlay)
endif()
